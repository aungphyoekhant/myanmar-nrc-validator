{
  "name": "myanmar-nrc-validator",
  "version": "1.1.2",
  "description": "A robust TypeScript library to validate, parse, and format Myanmar NRC numbers, states, townships, and citizen types.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "eng.traineddata",
    "mya.traineddata",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "myanmar-nrc-validator": "./dist/cli.js",
    "nrc": "./dist/cli.js"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsc",
    "dev:test": "tsx src/test.ts",
    "mcp:dev": "tsx src/mcp-server.ts",
    "prepublishOnly": "npm run build",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "myanmar",
    "nrc",
    "validator",
    "burmese-nrc",
    "nrc-parser",
    "cannopy-fleet"
  ],
  "author": "Aung Phyo Khant",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@modelcontextprotocol/inspector": "^2.11.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/node": "^22.0.0",
    "@types/sharp": "^0.31.1",
    "rimraf": "^6.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0",
    "zod": "^3.24.0"
  }
}
